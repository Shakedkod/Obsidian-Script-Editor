		"blob-stream": "^0.1.3",
		"brfs": "^2.0.2",
		"browserify": "^17.0.1",
		"file-saver": "^2.0.5",
		"fs": "^0.0.1-security",
		"markdown-it": "^14.1.0",
		"markdown-it-mathjax3": "^4.3.2",
		"pdf-lib": "^1.17.1",
		"pdfkit": "^0.17.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	}
